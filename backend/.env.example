# Runtime mode: development, testing, or production.
APP_ENV=development

# API observability and limits. Do not enable DEBUG logging for sensitive deployments.
LOG_LEVEL=INFO
ENABLE_API_DOCS=true
MAX_UPLOAD_SIZE_MB=20

# Comma-separated browser origins allowed to call this API. Do not use * with credentials.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. The analysis pipeline runs without MongoDB. Configure this to enable Module 11 paper and analysis history.
# MONGO_URI=mongodb://username:password@hostname:27017/?authSource=admin
DATABASE_NAME=paperintel_ai
